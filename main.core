    -- Offset 1: Dive Speed
    HexPatches.MemoryPatch("libunity.so", 0x6171480, "h40 00 00 1C")
    HexPatches.MemoryPatch("libunity.so", 0x6171480 + 4, "hC0 03 5F D6")
    HexPatches.MemoryPatch("libunity.so", 0x6171480 + 8, hexValue, 4)

    -- Offset 2: Dive Acceleration
    HexPatches.MemoryPatch("libunity.so", 0x61714E4, "h40 00 00 1C")
    HexPatches.MemoryPatch("libunity.so", 0x61714E4 + 4, "hC0 03 5F D6")
    HexPatches.MemoryPatch("libunity.so", 0x61714E4 + 8, hexValue, 4)

